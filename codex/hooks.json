{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Checking goldband workflow hints"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Loading goldband context hints"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Checking goldband Bash policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Checking goldband approval policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Recording goldband tool context"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Checking goldband subagent evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.codex/hooks/hook-router.js\"",
            "commandWindows": "node \"$env:USERPROFILE/.codex/hooks/hook-router.js\"",
            "timeout": 5,
            "statusMessage": "Checking goldband stop policy"
          }
        ]
      }
    ]
  }
}
