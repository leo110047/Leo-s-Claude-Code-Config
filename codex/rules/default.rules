prefix_rule(pattern=["/bin/zsh", "-lc", "python3 -c $'from studio_os import continuation\\nfrom studio_os.db import connect\\nimport json\\nold_id = \"run-pursuit-draft-continuation-e21a5d37\"\\nwith connect() as conn:\\n    old = conn.execute(\"SELECT payload_json FROM agent_runs WHERE id = ?\", (old_id,)).fetchone()\\n    if old is None:\\n        raise SystemExit(\"old payload not found\")\\n    payload = json.loads(old[\"payload_json\"])\\nqueued = continuation.enqueue_continuation_run(\\n    run_type=\"pursuit_draft_continuation\",\\n    related_type=\"pursuit_runs\",\\n    related_id=\"pursuit-pro360-274f22d1\",\\n    result=payload,\\n    summary=\"Queued outreach draft agent after enabling pursuit workflow tool actions\",\\n)\\nprint({\"status\": \"queued\", \"run_id\": queued[\"id\"]})\\ncontinuation.run_continuation(queued[\"id\"])\\nwith connect() as conn:\\n    row = conn.execute(\"SELECT status, attempts, summary FROM agent_runs WHERE id = ?\", (queued[\"id\"],)).fetchone()\\n    pursuit = conn.execute(\"SELECT status, substr(client_name,1,80) client_name, substr(requirement_detail,1,120) requirement_detail FROM pursuit_runs WHERE id = ?\", (\"pursuit-pro360-274f22d1\",)).fetchone()\\n    drafts = conn.execute(\"SELECT id,status,version,substr(body,1,160) body FROM outreach_drafts WHERE pursuit_run_id = ? ORDER BY created_at DESC LIMIT 3\", (\"pursuit-pro360-274f22d1\",)).fetchall()\\n    print(dict(row))\\n    print(dict(pursuit))\\n    print([dict(d) for d in drafts])'"], decision="allow")
