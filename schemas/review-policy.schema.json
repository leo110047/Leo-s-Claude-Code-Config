{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldband.dev/schemas/review-policy.schema.json",
  "title": "Goldband Authoritative Review Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "minimumEvidenceLevels", "waivers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "minimumEvidenceLevels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cellIds", "minimumLevel", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cellIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "minimumLevel": { "enum": ["fixture", "local", "sandboxed-service", "live-provider", "device-platform", "production-readback"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cellId", "allowedChanges", "reason", "approvedBy", "approvedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cellId": { "type": "string", "minLength": 1 },
          "allowedChanges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cell-contract", "risk", "disposition", "provider-contract", "evidence-level", "finding-detachment"] } },
          "reason": { "type": "string", "minLength": 1 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
