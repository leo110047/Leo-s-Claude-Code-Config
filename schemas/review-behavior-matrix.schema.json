{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldband.dev/schemas/review-behavior-matrix.schema.json",
  "title": "Goldband Review Behavior Matrix",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "behavior", "kind", "input", "preconditions", "expected", "risk", "disposition", "providerIds"],
    "allOf": [
      {
        "if": {
          "properties": {
            "disposition": { "enum": ["manual", "not-applicable", "unsupported"] }
          },
          "required": ["disposition"]
        },
        "then": { "required": ["reason"] },
        "else": {
          "properties": {
            "providerIds": { "minItems": 1 }
          }
        }
      }
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
      "behavior": { "type": "string", "minLength": 1 },
      "kind": { "enum": ["normal", "branch", "exception", "boundary"] },
      "input": { "type": "string", "minLength": 1 },
      "preconditions": { "type": "string", "minLength": 1 },
      "expected": { "type": "string", "minLength": 1 },
      "risk": { "enum": ["low", "medium", "high"] },
      "disposition": { "enum": ["automated", "static", "runtime-readback", "manual", "not-applicable", "unsupported"] },
      "providerIds": {
        "type": "array",
        "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "uniqueItems": true
      },
      "reason": { "type": "string", "minLength": 1 }
    }
  }
}
