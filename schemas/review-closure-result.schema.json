{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldband.dev/schemas/review-closure-result.schema.json",
  "title": "Goldband Scoped Review Closure Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "evidence-incomplete" } }, "required": ["status"] },
            "else": {
              "properties": {
                "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true }
              }
            }
          }
        ],
        "required": ["findingId", "status", "summary", "evidenceIds"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "status": { "enum": ["closed", "still-open", "direct-regression", "evidence-incomplete"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidenceIds": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    }
  }
}
