    _link_or_copy "$goldband_dir/browse/dist" "$factory_goldband/browse/dist"
  fi
  if [ -d "$goldband_dir/browse/bin" ]; then
    _link_or_copy "$goldband_dir/browse/bin" "$factory_goldband/browse/bin"
  fi
  if [ -f "$factory_dir/goldband-upgrade/SKILL.md" ]; then
    _link_or_copy "$factory_dir/goldband-upgrade/SKILL.md" "$factory_goldband/goldband-upgrade/SKILL.md"
  fi
  for f in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
