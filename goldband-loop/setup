    fi
  done
  if [ -f "$goldband_dir/ETHOS.md" ]; then
    _link_or_copy "$goldband_dir/ETHOS.md" "$factory_goldband/ETHOS.md"
  fi
}

create_opencode_runtime_root() {
  local goldband_dir="$1"
  local opencode_goldband="$2"
  local opencode_dir="$goldband_dir/.opencode/skills"

  if [ -L "$opencode_goldband" ]; then
    rm -f "$opencode_goldband"
  elif [ -d "$opencode_goldband" ] && [ "$opencode_goldband" != "$goldband_dir" ]; then
    rm -rf "$opencode_goldband"
  fi

  mkdir -p "$opencode_goldband" "$opencode_goldband/browse" "$opencode_goldband/design" "$opencode_goldband/goldband-upgrade" "$opencode_goldband/review" "$opencode_goldband/qa" "$opencode_goldband/plan-devex-review"

  if [ -f "$opencode_dir/goldband/SKILL.md" ]; then
    _link_or_copy "$opencode_dir/goldband/SKILL.md" "$opencode_goldband/SKILL.md"
  fi
  if [ -d "$goldband_dir/bin" ]; then
    _link_or_copy "$goldband_dir/bin" "$opencode_goldband/bin"
  fi
  if [ -d "$goldband_dir/lib" ]; then
    _link_or_copy "$goldband_dir/lib" "$opencode_goldband/lib"
  fi
  if [ -d "$goldband_dir/browse/dist" ]; then
    _link_or_copy "$goldband_dir/browse/dist" "$opencode_goldband/browse/dist"
  fi
  if [ -d "$goldband_dir/browse/bin" ]; then
    _link_or_copy "$goldband_dir/browse/bin" "$opencode_goldband/browse/bin"
  fi
  if [ -d "$goldband_dir/design/dist" ]; then
    _link_or_copy "$goldband_dir/design/dist" "$opencode_goldband/design/dist"
  fi
  if [ -f "$opencode_dir/goldband-upgrade/SKILL.md" ]; then
    _link_or_copy "$opencode_dir/goldband-upgrade/SKILL.md" "$opencode_goldband/goldband-upgrade/SKILL.md"
  fi
  for f in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
    if [ -f "$goldband_dir/review/$f" ]; then
      _link_or_copy "$goldband_dir/review/$f" "$opencode_goldband/review/$f"
    fi
  done
  if [ -d "$goldband_dir/review/specialists" ]; then
    _link_or_copy "$goldband_dir/review/specialists" "$opencode_goldband/review/specialists"
  fi
  if [ -d "$goldband_dir/qa/templates" ]; then
    _link_or_copy "$goldband_dir/qa/templates" "$opencode_goldband/qa/templates"
  fi
  if [ -d "$goldband_dir/qa/references" ]; then
    _link_or_copy "$goldband_dir/qa/references" "$opencode_goldband/qa/references"
  fi
  if [ -f "$goldband_dir/plan-devex-review/dx-hall-of-fame.md" ]; then
    _link_or_copy "$goldband_dir/plan-devex-review/dx-hall-of-fame.md" "$opencode_goldband/plan-devex-review/dx-hall-of-fame.md"
  fi
  if [ -f "$goldband_dir/ETHOS.md" ]; then
    _link_or_copy "$goldband_dir/ETHOS.md" "$opencode_goldband/ETHOS.md"
  fi
}

write_workflow_profile_marker() {
  local host="$1"
  local profile="$2"
  mkdir -p "$HOME/.goldband/state"
  printf '%s\n' "$profile" > "$HOME/.goldband/state/workflow-profile-$host"
}

link_factory_skill_dirs() {
  local goldband_dir="$1"
  local skills_dir="$2"
  local factory_dir="$goldband_dir/.factory/skills"
  local linked=()

  if [ ! -d "$factory_dir" ]; then
    echo "  Generating .factory/ skill docs..."
    ( cd "$goldband_dir" && bun run gen:skill-docs --host factory )
  fi

  if [ ! -d "$factory_dir" ]; then
    echo "  warning: .factory/skills/ generation failed — run 'bun run gen:skill-docs --host factory' manually" >&2
    return 1
  fi

  for skill_dir in "$factory_dir"/goldband*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      [ "$skill_name" = "goldband" ] && continue
      target="$skills_dir/$skill_name"
      if [ -L "$target" ] || [ ! -e "$target" ]; then
        _link_or_copy "$skill_dir" "$target"
        linked+=("$skill_name")
      fi
    fi
  done
  if [ ${#linked[@]} -gt 0 ]; then
    echo "  linked skills: ${linked[*]}"
  fi
}

link_opencode_skill_dirs() {
  local goldband_dir="$1"
  local skills_dir="$2"
  local opencode_dir="$goldband_dir/.opencode/skills"
  local linked=()

  if [ ! -d "$opencode_dir" ]; then
    echo "  Generating .opencode/ skill docs..."
    ( cd "$goldband_dir" && bun run gen:skill-docs --host opencode )
  fi

  if [ ! -d "$opencode_dir" ]; then
    echo "  warning: .opencode/skills/ generation failed — run 'bun run gen:skill-docs --host opencode' manually" >&2
    return 1
  fi

  for skill_dir in "$opencode_dir"/goldband*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      [ "$skill_name" = "goldband" ] && continue
      target="$skills_dir/$skill_name"
      if [ -L "$target" ] || [ ! -e "$target" ]; then
        _link_or_copy "$skill_dir" "$target"
        linked+=("$skill_name")
      fi
    fi
  done
  if [ ${#linked[@]} -gt 0 ]; then
    echo "  linked skills: ${linked[*]}"
  fi
}

# 4. Install for Claude (default)
SKILLS_BASENAME="$(basename "$INSTALL_SKILLS_DIR")"
SKILLS_PARENT_BASENAME="$(basename "$(dirname "$INSTALL_SKILLS_DIR")")"
CODEX_REPO_LOCAL=0
if [ "$SKILLS_BASENAME" = "skills" ] && [ "$SKILLS_PARENT_BASENAME" = ".agents" ]; then
  CODEX_REPO_LOCAL=1
fi

if [ "$INSTALL_CLAUDE" -eq 1 ]; then
  if [ "$SKILLS_BASENAME" = "skills" ]; then
    "$SOURCE_GOLDBAND_DIR/bin/goldband-patch-names" "$SOURCE_GOLDBAND_DIR" "$SKILL_PREFIX"
    INSTALL_GOLDBAND_DIR="$INSTALL_SKILLS_DIR/goldband"
    create_claude_runtime_root "$SOURCE_GOLDBAND_DIR" "$INSTALL_GOLDBAND_DIR"
    cleanup_legacy_full_workflow_entries_for_standard "$SOURCE_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR" "" "claude"
    link_claude_selected_skill_dirs "$SOURCE_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR" "goldband-upgrade"
    cleanup_claude_root_skill_alias "$INSTALL_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR"
    if [ "$LOCAL_INSTALL" -eq 1 ]; then
      log "goldband ready (project-local)."
      log "  skills: $INSTALL_SKILLS_DIR"
    else
      log "goldband ready (claude, $WORKFLOW_PROFILE profile)."
    fi
    log "  browse: $BROWSE_BIN"
    write_workflow_profile_marker "claude" "$WORKFLOW_PROFILE"
  else
    # Not inside a skills/ directory — would symlink the source into
    # ~/.claude/skills/goldband/ and register from there.
    CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
    CLAUDE_GOLDBAND_LINK="$CLAUDE_SKILLS_DIR/goldband"

    # Conductor worktree guard: if ~/.claude/skills/goldband is already a real
    # (non-symlink) directory pointing to a *different* install, refuse to plant
    # a symlink there. On macOS/BSD, `ln -snf SRC DST` won't replace a real DST;
    # it creates DST/$(basename SRC) → SRC inside it. The result is per-worktree
    # symlinks leaking into the global install that Claude Code picks up as
    # separate top-level skills (dublin-v1, lincoln-v2, ...). Typical trigger:
    # running ./setup from a Conductor worktree of the goldband repo itself.
    _SKIP_CLAUDE_REGISTER=0
    if [ -d "$CLAUDE_GOLDBAND_LINK" ] && [ ! -L "$CLAUDE_GOLDBAND_LINK" ]; then
      _EXISTING_REAL=$(cd "$CLAUDE_GOLDBAND_LINK" 2>/dev/null && pwd -P || echo "")
      if [ -n "$_EXISTING_REAL" ] && [ "$_EXISTING_REAL" != "$SOURCE_GOLDBAND_DIR" ]; then
        if [ ! -f "$CLAUDE_GOLDBAND_LINK/.installed-version" ] && [ ! -x "$CLAUDE_GOLDBAND_LINK/bin/goldband-config" ]; then
          _SKIP_CLAUDE_REGISTER=1
        fi
      fi
    fi

    if [ "$_SKIP_CLAUDE_REGISTER" -eq 1 ]; then
      log ""
      log "  $CLAUDE_GOLDBAND_LINK already exists as a separate global install."
      log "  Skipping Claude skill registration to avoid polluting it with"
      log "  per-worktree symlinks. (Binaries still built locally for dev.)"
      log ""
      log "    Global install:  $CLAUDE_GOLDBAND_LINK"
      log "    This worktree:   $SOURCE_GOLDBAND_DIR"
      log ""
      log "  To register this worktree as the active goldband, remove the global"
      log "  install first:  rm -rf $CLAUDE_GOLDBAND_LINK"
      log ""
      log "goldband built (claude registration skipped)."
      log "  browse: $BROWSE_BIN"
    else
      mkdir -p "$CLAUDE_SKILLS_DIR"
      INSTALL_SKILLS_DIR="$CLAUDE_SKILLS_DIR"
      "$SOURCE_GOLDBAND_DIR/bin/goldband-patch-names" "$SOURCE_GOLDBAND_DIR" "$SKILL_PREFIX"
      INSTALL_GOLDBAND_DIR="$CLAUDE_GOLDBAND_LINK"
      create_claude_runtime_root "$SOURCE_GOLDBAND_DIR" "$INSTALL_GOLDBAND_DIR"
      cleanup_legacy_full_workflow_entries_for_standard "$SOURCE_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR" "" "claude"
      link_claude_selected_skill_dirs "$SOURCE_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR" "goldband-upgrade"
      cleanup_claude_root_skill_alias "$INSTALL_GOLDBAND_DIR" "$INSTALL_SKILLS_DIR"
      log "goldband ready (claude, $WORKFLOW_PROFILE profile)."
      log "  browse: $BROWSE_BIN"
      write_workflow_profile_marker "claude" "$WORKFLOW_PROFILE"
    fi
  fi
fi

# 5. Install for Codex
if [ "$INSTALL_CODEX" -eq 1 ]; then
  if [ "$CODEX_REPO_LOCAL" -eq 1 ]; then
    CODEX_SKILLS="$INSTALL_SKILLS_DIR"
    CODEX_GOLDBAND="$INSTALL_GOLDBAND_DIR"
  fi
  mkdir -p "$CODEX_SKILLS"

  # Skip runtime root creation for repo-local installs — the checkout IS the runtime root.
  # create_codex_runtime_root would create self-referential symlinks (bin → bin, etc.).
  if [ "$CODEX_REPO_LOCAL" -eq 0 ]; then
    create_codex_runtime_root "$SOURCE_GOLDBAND_DIR" "$CODEX_GOLDBAND"
  else
    create_internal_workflow_docs "$SOURCE_GOLDBAND_DIR/.agents/skills" "$CODEX_GOLDBAND"
  fi
  cleanup_legacy_full_workflow_entries_for_standard "$SOURCE_GOLDBAND_DIR" "$CODEX_SKILLS" "$SOURCE_GOLDBAND_DIR/.agents/skills" "codex"
  link_codex_selected_skill_dirs "$SOURCE_GOLDBAND_DIR" "$CODEX_SKILLS" "goldband-upgrade"

  log "goldband ready (codex, $WORKFLOW_PROFILE profile)."
  log "  browse: $BROWSE_BIN"
  log "  codex skills: $CODEX_SKILLS"
  write_workflow_profile_marker "codex" "$WORKFLOW_PROFILE"
fi

# 6. Install for Kiro CLI (copy from .agents/skills, rewrite paths)
if [ "$INSTALL_KIRO" -eq 1 ]; then
  KIRO_SKILLS="$HOME/.kiro/skills"
  AGENTS_DIR="$SOURCE_GOLDBAND_DIR/.agents/skills"
  mkdir -p "$KIRO_SKILLS"

  # Create goldband dir with symlinks for runtime assets, copy+sed for SKILL.md
  KIRO_GOLDBAND="$KIRO_SKILLS/goldband"
  # Remove old whole-dir symlink from previous installs
  [ -L "$KIRO_GOLDBAND" ] && rm -f "$KIRO_GOLDBAND"
  mkdir -p "$KIRO_GOLDBAND" "$KIRO_GOLDBAND/browse" "$KIRO_GOLDBAND/goldband-upgrade" "$KIRO_GOLDBAND/review"
  _link_or_copy "$SOURCE_GOLDBAND_DIR/bin" "$KIRO_GOLDBAND/bin"
  _link_or_copy "$SOURCE_GOLDBAND_DIR/browse/dist" "$KIRO_GOLDBAND/browse/dist"
  _link_or_copy "$SOURCE_GOLDBAND_DIR/browse/bin" "$KIRO_GOLDBAND/browse/bin"
  # ETHOS.md — referenced by "Search Before Building" in all skill preambles
  if [ -f "$SOURCE_GOLDBAND_DIR/ETHOS.md" ]; then
    _link_or_copy "$SOURCE_GOLDBAND_DIR/ETHOS.md" "$KIRO_GOLDBAND/ETHOS.md"
  fi
  # goldband-upgrade skill
  if [ -f "$AGENTS_DIR/goldband-upgrade/SKILL.md" ]; then
    _link_or_copy "$AGENTS_DIR/goldband-upgrade/SKILL.md" "$KIRO_GOLDBAND/goldband-upgrade/SKILL.md"
  fi
  # Review runtime assets (individual files, not whole dir)
  for f in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
    if [ -f "$SOURCE_GOLDBAND_DIR/review/$f" ]; then
      _link_or_copy "$SOURCE_GOLDBAND_DIR/review/$f" "$KIRO_GOLDBAND/review/$f"
    fi
  done

  # Rewrite root SKILL.md paths for Kiro
  sed -e "s|~/.claude/skills/goldband|~/.kiro/skills/goldband|g" \
      -e "s|\.claude/skills/goldband|.kiro/skills/goldband|g" \
      -e "s|\.claude/skills|.kiro/skills|g" \
      "$SOURCE_GOLDBAND_DIR/SKILL.md" > "$KIRO_GOLDBAND/SKILL.md"

  if [ ! -d "$AGENTS_DIR" ]; then
    echo "  warning: no .agents/skills/ directory found — run 'bun run build' first" >&2
  else
    for skill_dir in "$AGENTS_DIR"/goldband*/; do
      [ -f "$skill_dir/SKILL.md" ] || continue
      skill_name="$(basename "$skill_dir")"
      target_dir="$KIRO_SKILLS/$skill_name"
      mkdir -p "$target_dir"
      # Generated Codex skills use $HOME/.codex (not ~/), plus $GOLDBAND_ROOT variables.
      # Rewrite the default GOLDBAND_ROOT value and any remaining literal paths.
      sed -e 's|\$HOME/.codex/skills/goldband|$HOME/.kiro/skills/goldband|g' \
          -e "s|~/.codex/skills/goldband|~/.kiro/skills/goldband|g" \
          -e "s|~/.claude/skills/goldband|~/.kiro/skills/goldband|g" \
          "$skill_dir/SKILL.md" > "$target_dir/SKILL.md"
    done
    echo "goldband ready (kiro)."
    echo "  browse: $BROWSE_BIN"
    echo "  kiro skills: $KIRO_SKILLS"
  fi
fi

# 6b. Install for Factory Droid
if [ "$INSTALL_FACTORY" -eq 1 ]; then
  mkdir -p "$FACTORY_SKILLS"
  create_factory_runtime_root "$SOURCE_GOLDBAND_DIR" "$FACTORY_GOLDBAND"
  link_factory_skill_dirs "$SOURCE_GOLDBAND_DIR" "$FACTORY_SKILLS"
  echo "goldband ready (factory)."
  echo "  browse: $BROWSE_BIN"
  echo "  factory skills: $FACTORY_SKILLS"
fi

# 6c. Install for OpenCode
if [ "$INSTALL_OPENCODE" -eq 1 ]; then
  mkdir -p "$OPENCODE_SKILLS"
  create_opencode_runtime_root "$SOURCE_GOLDBAND_DIR" "$OPENCODE_GOLDBAND"
  link_opencode_skill_dirs "$SOURCE_GOLDBAND_DIR" "$OPENCODE_SKILLS"
  echo "goldband ready (opencode)."
  echo "  browse: $BROWSE_BIN"
  echo "  opencode skills: $OPENCODE_SKILLS"
fi

# 7. Create .agents/ sidecar symlinks for the real Codex skill target.
# The root Codex skill ends up pointing at $SOURCE_GOLDBAND_DIR/.agents/skills/goldband,
# so the runtime assets must live there for both global and repo-local installs.
if [ "$INSTALL_CODEX" -eq 1 ]; then
  create_agents_sidecar "$SOURCE_GOLDBAND_DIR"
fi

# 8. Run pending version migrations
# Migrations handle state fixes that ./setup alone can't cover (stale config,
# orphaned files, directory structure changes). Each migration is idempotent.
MIGRATIONS_DIR="$SOURCE_GOLDBAND_DIR/goldband-upgrade/migrations"
CURRENT_VERSION=$(cat "$SOURCE_GOLDBAND_DIR/VERSION" 2>/dev/null || echo "unknown")
LAST_SETUP_VERSION=$(cat "$HOME/.goldband/.last-setup-version" 2>/dev/null || echo "0.0.0.0")
if [ -d "$MIGRATIONS_DIR" ] && [ "$CURRENT_VERSION" != "unknown" ] && [ "$LAST_SETUP_VERSION" != "$CURRENT_VERSION" ]; then
  # Fresh install (no marker file) — skip migrations, just write marker
  if [ ! -f "$HOME/.goldband/.last-setup-version" ]; then
    : # fall through to marker write below
  else
    find "$MIGRATIONS_DIR" -maxdepth 1 -name 'v*.sh' -type f 2>/dev/null | sort -V | while IFS= read -r migration; do
      m_ver="$(basename "$migration" .sh | sed 's/^v//')"
      # Run if migration is newer than last setup version AND not newer than current version
      if [ "$(printf '%s\n%s' "$LAST_SETUP_VERSION" "$m_ver" | sort -V | head -1)" = "$LAST_SETUP_VERSION" ] && [ "$LAST_SETUP_VERSION" != "$m_ver" ] \
         && [ "$(printf '%s\n%s' "$m_ver" "$CURRENT_VERSION" | sort -V | tail -1)" = "$CURRENT_VERSION" ]; then
        echo "  running migration $m_ver..."
        bash "$migration" || echo "  warning: migration $m_ver had errors (non-fatal)"
      fi
    done
  fi
fi
mkdir -p "$HOME/.goldband"
if [ "$CURRENT_VERSION" != "unknown" ]; then
  echo "$CURRENT_VERSION" > "$HOME/.goldband/.last-setup-version"
fi

# 9. First-time welcome + legacy cleanup
if [ ! -f "$HOME/.goldband/.welcome-seen" ]; then
  log "  Welcome! Run /goldband-upgrade anytime to stay current."
  touch "$HOME/.goldband/.welcome-seen"
fi
rm -f /tmp/goldband-latest-version

# 10. Team mode: register/unregister SessionStart hook
SETTINGS_HOOK="$SOURCE_GOLDBAND_DIR/bin/goldband-settings-hook"
HOOK_CMD="$SOURCE_GOLDBAND_DIR/bin/goldband-session-update"

if [ "$TEAM_MODE" -eq 1 ]; then
  "$GOLDBAND_CONFIG" set auto_upgrade true 2>/dev/null || true
  "$GOLDBAND_CONFIG" set team_mode true 2>/dev/null || true

  # Register SessionStart hook in Claude Code settings
  if [ -x "$SETTINGS_HOOK" ]; then
    "$SETTINGS_HOOK" add "$HOOK_CMD" 2>/dev/null || true
  fi

  log ""
  log "Team mode enabled: goldband will auto-update at the start of each Claude Code session."
  log "  Hook: $HOOK_CMD"
  log "  To disable: ./setup --no-team"
  log ""
  log "Bootstrap your repo:"
  log "  cd <your-repo> && $SOURCE_GOLDBAND_DIR/bin/goldband-team-init required"
fi

if [ "$NO_TEAM_MODE" -eq 1 ]; then
  "$GOLDBAND_CONFIG" set auto_upgrade false 2>/dev/null || true
  "$GOLDBAND_CONFIG" set team_mode false 2>/dev/null || true

  # Remove SessionStart hook from Claude Code settings
  if [ -x "$SETTINGS_HOOK" ]; then
    "$SETTINGS_HOOK" remove "$HOOK_CMD" 2>/dev/null || true
  fi

  log "Team mode disabled: auto-update hook removed."
fi
