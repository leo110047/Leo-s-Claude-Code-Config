{
  "version": "0.1.0",
  "scripts": {
    "generate:manifest": "node scripts/generate-goldband-surfaces.mjs",
    "check:manifest": "node scripts/generate-goldband-surfaces.mjs --check",
    "lint:style": "node scripts/check-code-style.mjs",
    "lint:style:staged": "node scripts/check-code-style.mjs --staged",
    "test:hook-router": "node hooks/scripts/tools/replay-hook-router.js && node scripts/test-claude-hook-router-review-readonly.mjs",
    "test:selector-parity": "node scripts/test-goldband-selector-parity.mjs",
    "test:telemetry": "node scripts/test-telemetry-schema.mjs && node scripts/test-telemetry.mjs && node scripts/test-telemetry-otlp.mjs && node scripts/test-telemetry-miner.mjs",
    "test:hook-router:coverage": "node scripts/check-hook-router-coverage.mjs",
    "test:cross-review": "node scripts/test-cross-review.mjs && node scripts/test-cross-review-regressions.mjs",
    "test:plugin-distribution": "node scripts/test-rules-resolver.mjs && node scripts/test-codex-runtime-install.mjs && node scripts/check-plugin-distribution.mjs",
    "test:mcp-server": "npm --prefix mcp/server test",
    "smoke:mcp-server": "npm --prefix mcp/server run smoke",
    "test:eval-budget-cap": "node scripts/test-eval-budget-cap.mjs",
    "test:style-gate": "node scripts/test-code-style-gate.mjs",
    "test:auto-update": "node scripts/test-auto-update.mjs",
    "test:project-style-gate": "node scripts/test-goldband-project-style-gate.mjs",
    "sync:app-support": "node scripts/sync-app-support-assets.mjs && node scripts/build-claude-app-adapters.mjs",
    "test:app-support": "node scripts/check-app-support.mjs",
    "test:evals": "cd goldband-loop && bun run test:evals",
    "test:e2e": "cd goldband-loop && bun run test:e2e",
    "test:gate": "cd goldband-loop && bun run test:gate",
    "test:periodic": "cd goldband-loop && bun run test:periodic"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0"
  }
}
